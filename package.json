{
  "name": "jpmcglone-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "deploy": "gh-pages -d .output/public --nojekyll",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "check:site": "node scripts/check-site.mjs",
    "audit": "npm audit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/ui": "^4.11.2",
    "date-fns": "^4.4.0",
    "motion-v": "^2.4.4",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.14",
    "@iconify-json/simple-icons": "^1.2.97",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@vueuse/nuxt": "^15.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "node": "^24.21.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11"
  },
  "overrides": {
    "fontless": {
      "esbuild": "^0.28.2"
    }
  }
}
